# Klucz API Google Gemini (wymagany do działania technologii AI)
API_KEY=twoj_klucz_api_tutaj

# ─── Powiadomienia Telegram (opcjonalne) ─────────────────────────────────────
# Token bota uzyskany od @BotFather oraz ID czatu, na który mają iść alerty.
# Gdy oba są ustawione, backend cyklicznie skanuje rynek i wysyła sygnały.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minimalny poziom istotności wysyłanych alertów: low | medium | high (domyślnie high)
ALERT_SEVERITY=high
# Harmonogram skanu w formacie cron (domyślnie 8:00 codziennie)
ALERT_CRON=0 8 * * *

# Opcjonalnie porty (jeśli chcesz zmienić domyślne w docker-compose.yml)
